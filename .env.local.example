# 지시서 0-12 — 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env.local 은 .gitignore 에 있으므로 GitHub 에 올라가지 않는다.
# NEXT_PUBLIC_ 으로 시작하는 것만 브라우저에 노출된다. 나머지는 서버(API Route)에서만 쓴다.

# --- 카카오 (지시서 0-10) ---
# 카카오맵 JavaScript SDK 키. 브라우저에 노출되므로 도메인 등록으로 제한한다.
# 등록할 도메인: http://localhost:3000 과 Vercel 주소
NEXT_PUBLIC_KAKAO_JS_KEY=

# 카카오모빌리티 길찾기 REST 키. 서버에서만 쓴다 (app/api/route).
KAKAO_REST_API_KEY=

# --- 기상청 단기예보 (지시서 0-11, 공공데이터포털) ---
# 일반 인증키(Decoding) 를 넣는다. 서버에서만 쓴다 (app/api/weather).
KMA_SERVICE_KEY=

# --- Supabase (지시서 0-8) — 4단계 이후에 채운다. 비어 있으면 브라우저 저장소로 동작한다. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
