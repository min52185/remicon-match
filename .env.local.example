# 지시서 0-12 — 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env.local 은 .gitignore 에 있으므로 GitHub 에 올라가지 않는다.
# NEXT_PUBLIC_ 으로 시작하는 것만 브라우저에 노출된다. 나머지는 서버(API Route)에서만 쓴다.

# --- 카카오 (지시서 0-10) ---
# 카카오맵 JavaScript SDK 키. 브라우저에 노출되므로 도메인 등록으로 제한한다.
# 등록할 도메인: http://localhost:3000 과 Vercel 주소
NEXT_PUBLIC_KAKAO_JS_KEY=

# 카카오모빌리티 길찾기 REST 키. 서버에서만 쓴다 (app/api/route).
KAKAO_REST_API_KEY=

# --- 기상청 단기예보 (지시서 0-11, 공공데이터포털) ---
# 일반 인증키(Decoding) 를 넣는다. 서버에서만 쓴다 (app/api/weather).
KMA_SERVICE_KEY=

# --- 레캉쌤 AI 도우미 (LLM) — 서버에서만 쓴다 (app/api/assistant) ---
# 둘 다 비어 있으면 레캉쌤이 앱이 계산한 숫자로 정해진 문장만 답한다.
# 둘 다 있으면 Gemini 를 먼저 쓴다. 바꾸려면 LLM_PROVIDER=claude
#
# Google Gemini — aistudio.google.com 에서 받은 키. 무료 사용 구간이 있다.
#   무료 구간에서는 보낸 내용이 구글 제품 개선에 쓰일 수 있다 (시연용 가상 데이터만 보낸다).
GEMINI_API_KEY=
# 비워 두면 gemini-3.6-flash. 무료 구간 모델 목록: ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=
# Anthropic Claude — console.anthropic.com 에서 받은 키. 쓴 만큼 요금이 나간다.
ANTHROPIC_API_KEY=
# gemini 또는 claude. 비워 두면 키가 있는 쪽
LLM_PROVIDER=

# --- Supabase (지시서 0-8) — 4단계 이후에 채운다. 비어 있으면 브라우저 저장소로 동작한다. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 주의: 이 키는 쓰지 않는다 (CLAUDE.md). RLS(권한 검사)를 통째로 무시하는 키라
#       한 번이라도 브라우저로 새면 남의 회사 자료가 전부 열린다. 비워 둔다.
SUPABASE_SERVICE_ROLE_KEY=
